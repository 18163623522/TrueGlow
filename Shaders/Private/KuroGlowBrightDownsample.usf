// BrightPass + 4-tap 降采样到 1/2。每 tap 先软阈值再平均，保住尖峰能量。

#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"
#include "/Plugin/KuroGlow/Private/KuroGlowCommon.ush"

Texture2D InputTexture;
SamplerState InputSampler;

SCREEN_PASS_TEXTURE_VIEWPORT(Input)
SCREEN_PASS_TEXTURE_VIEWPORT(Output)

float4 InputUVScaleBias;
float Threshold;
float Knee;
float4 Tint;

float4 SampleBright(float2 UV)
{
	float4 Color = Texture2DSampleLevel(
		InputTexture, InputSampler,
		clamp(UV, Input_UVViewportBilinearMin, Input_UVViewportBilinearMax), 0);

	return float4(KuroGlowSoftThreshold(Color.rgb, Threshold, Knee), 0.0);
}

void MainPS(float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	const float2 UV = SvPosition.xy * Output_ExtentInverse;
	const float2 InUV = UV * InputUVScaleBias.xy + InputUVScaleBias.zw;

	const float2 Off = Input_ExtentInverse;

	float4 S0 = SampleBright(InUV + Off * float2(-1.0, -1.0));
	float4 S1 = SampleBright(InUV + Off * float2( 1.0, -1.0));
	float4 S2 = SampleBright(InUV + Off * float2(-1.0,  1.0));
	float4 S3 = SampleBright(InUV + Off * float2( 1.0,  1.0));

	OutColor = ((S0 + S1 + S2 + S3) * 0.25) * Tint;
}
